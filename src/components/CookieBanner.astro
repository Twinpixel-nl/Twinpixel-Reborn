---
const GA_ID = "G-Y0TE68DKL1";
---

<div id="cookie-banner" class="cookie-banner" hidden>
  <div class="cookie-banner__inner">
    <p>
      Wij gebruiken alleen statistische cookies om de website te verbeteren. 
    </p>
    <p>
      Lees meer in onze <a href="/privacy/">privacyverklaring</a>.
    </p>

    <div class="cookie-banner__actions">
      <button id="cookie-accept" type="button">Accepteren</button>
      <button id="cookie-reject" type="button">Weigeren</button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ GA_ID }}>
  const CONSENT_KEY = "tp_cookie_consent";

  function loadAnalytics() {
    if (window.__analyticsLoaded) return;
    window.__analyticsLoaded = true;

    const script = document.createElement("script");
    script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
    script.async = true;
    document.head.appendChild(script);

    window.dataLayer = window.dataLayer || [];
    window.gtag = function () {
      window.dataLayer.push(arguments);
    };

    window.gtag("js", new Date());
    window.gtag("config", GA_ID, {
      anonymize_ip: true,
      allow_google_signals: false
    });
  }

  function setConsent(value) {
    localStorage.setItem(CONSENT_KEY, value);
  }

  function getConsent() {
    return localStorage.getItem(CONSENT_KEY);
  }

  function trackEvent(name, params = {}) {
    if (getConsent() !== "accepted" || typeof window.gtag !== "function") return;
    window.gtag("event", name, {
      page_path: window.location.pathname,
      ...params
    });
  }

  function trackCurrentPageLead() {
    const params = new URLSearchParams(window.location.search);
    if (window.location.pathname !== "/contact/" || params.get("success") !== "1") return;

    const sessionKey = "tp_contact_lead_tracked";
    if (sessionStorage.getItem(sessionKey)) return;
    trackEvent("generate_lead", { form_name: "contact" });
    sessionStorage.setItem(sessionKey, "1");
  }

  function showBanner() {
    const banner = document.getElementById("cookie-banner");
    if (banner) banner.hidden = false;
  }

  function hideBanner() {
    const banner = document.getElementById("cookie-banner");
    if (banner) banner.hidden = true;
  }

  window.addEventListener("DOMContentLoaded", () => {
    const consent = getConsent();
    const acceptBtn = document.getElementById("cookie-accept");
    const rejectBtn = document.getElementById("cookie-reject");

    if (consent === "accepted") {
      loadAnalytics();
      trackCurrentPageLead();
      hideBanner();
    } else if (consent === "rejected") {
      hideBanner();
    } else {
      showBanner();
    }

    acceptBtn?.addEventListener("click", () => {
      setConsent("accepted");
      loadAnalytics();
      trackCurrentPageLead();
      hideBanner();
    });

    rejectBtn?.addEventListener("click", () => {
      setConsent("rejected");
      hideBanner();
    });

    document.addEventListener("click", (event) => {
      const link = event.target instanceof Element ? event.target.closest("a[href]") : null;
      if (!link) return;

      const href = link.getAttribute("href") || "";
      if (href.startsWith("mailto:")) {
        trackEvent("contact_email_click");
      } else if (href.includes("wa.me") || href.includes("whatsapp")) {
        trackEvent("contact_whatsapp_click");
      } else if (href === "/contact" || href === "/contact/") {
        trackEvent("cta_contact_click", { destination: "/contact/" });
      }
    });
  });
</script>